# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# live-run traces (large, regenerated by scripts/run-tier2-v2.ts)
test-data/**/logs/
test-data/**/validation-report.json
test-data/**/reliability-report.json
# regenerable sample sets (npx tsx scripts/gen-test-data.ts) and generated reports
test-data/csv/
test-data/xlsx/
test-data/test-scenarios.xlsx

# Next.js dev server regenerates these agent-rule files on every start
AGENTS.md
CLAUDE.md
